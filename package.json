{
  "name": "jakartabc",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=9.12.0"
  },
  "scripts": {
    "check:payload-versions": "node scripts/check-payload-versions.mjs",
    "build": "turbo run build --cache=local:rw",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint --cache=local:rw",
    "typecheck": "turbo run typecheck --cache=local:rw",
    "test": "turbo run test --cache=local:rw",
    "test:e2e": "turbo run test:e2e --cache=local:rw",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,md,json,yml,yaml}\""
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "prettier": "3.3.3",
    "turbo": "2.10.9",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "ws": "8.21.3",
      "js-yaml": "4.3.1",
      "brace-expansion": "2.1.4",
      "immutable": "4.3.9",
      "fast-uri": "3.1.5",
      "nanoid@3": "3.3.17",
      "dompurify": "3.4.13",
      "sharp": "0.35.0",
      "postcss": "8.5.23",
      "undici": "7.29.0"
    }
  }
}
