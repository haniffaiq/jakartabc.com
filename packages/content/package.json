{
  "name": "@jakartabc/content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./collections/*": "./src/collections/*.ts",
    "./globals/*": "./src/globals/*.ts",
    "./blocks/*": "./src/blocks/*.ts",
    "./cache/*": "./src/cache/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./generated/payload-types": "./src/generated/payload-types.ts"
  },
  "scripts": {
    "generate:types": "cd ../../apps/web && payload generate:types --config src/payload.config.ts && cp src/payload-types.ts ../../packages/content/src/generated/payload-types.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@payloadcms/richtext-lexical": "3.86.0",
    "payload": "3.86.0"
  },
  "devDependencies": {
    "@jakartabc/config": "workspace:*",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@types/node": "20.16.11",
    "@types/react": "19.2.18",
    "payload": "3.86.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  }
}
