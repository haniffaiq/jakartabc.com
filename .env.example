# ============================================================
# LOCAL DOCKER PORTS (avoid host collisions; e.g. petag on 3000/5432)
# Container internal ports unchanged. Host-side mapping:
#   web      → http://localhost:3100  (container 3000)
#   portal   → http://localhost:3101  (container 3001)
#   nginx    → http://localhost:8080  (container 80)
#   postgres (dev compose) → localhost:5433  (container 5432)
# ============================================================

# ----- Database -----
POSTGRES_USER=jakartabc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jakartabc
# Bundled local DB (alias `postgres` inside compose network):
DATABASE_URL=postgres://jakartabc:change-me@postgres:5432/jakartabc
# External DB example (Supabase / RDS / Neon / etc.) — replace above and run
# without the `bundled-db` profile:
# DATABASE_URL=postgres://USER:PW@db.example.com:5432/jakartabc?sslmode=require
#
# Usage:
#   Bundled local Postgres:  COMPOSE_PROFILES=bundled-db docker compose up -d
#   External DB:             docker compose up -d
# For app run on HOST against docker-compose.dev.yml postgres, use:
# DATABASE_URL=postgres://jakartabc:jakartabc@localhost:5433/jakartabc

# ----- Payload -----
PAYLOAD_SECRET=replace-with-32-plus-char-random-string

# ----- Next.js -----
# Local docker full stack: use http://localhost:3100
# Production: https://jakartabc.com
NEXT_PUBLIC_SITE_URL=http://localhost:3100
DEFAULT_LOCALE=en

# ----- nginx / TLS (certbot) -----
# Local docker stack: nginx serves plain HTTP on http://localhost:8080 and
# these values are unused. They are REQUIRED for the server TLS stack
# (docker-compose.tls.yml) and scripts/init-letsencrypt.sh.
WEB_DOMAIN=staging.jakartabc.com
PORTAL_DOMAIN=app.jakartabc.com
ACME_EMAIL=ops@jakartabc.com

# ----- Email (Phase 3) -----
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="Jakarta Business Center <hello@jakartabc.com>"
SALES_EMAIL=sales@jakartabc.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ----- Anti-spam (Phase 3) -----
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ----- Revalidation (Phase 2) -----
REVALIDATE_SECRET=replace-with-shared-secret

# ----- Portal (apps/portal) -----
PORTAL_PAYLOAD_SECRET=replace-with-32-plus-char-random-string
# Local: leave blank or set to localhost (cookie scoped to host)
# Production: app.jakartabc.com
PORTAL_COOKIE_DOMAIN=
NEXT_PUBLIC_PORTAL_URL=http://localhost:3101
