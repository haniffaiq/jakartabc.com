# ============================================================
# LOCAL DOCKER PORTS (avoid host collisions; e.g. petag on 3000)
# Container internal ports unchanged. Host-side mapping:
#   web      → http://localhost:3100  (container 3000)
#   portal   → http://localhost:3101  (container 3001)
# ============================================================

# ----- Database (shared / external Postgres) -----
# Postgres is NOT bundled in the compose stack — point at a reachable DB.
#   DB on the server host:  use host.docker.internal, not localhost
#   Managed DB:             add ?sslmode=require (or no-verify for RDS)
DATABASE_URL=postgres://USER:PW@host.docker.internal:5432/jakartabc
# App run on HOST (pnpm dev) against a local Postgres:
# DATABASE_URL=postgres://jakartabc:jakartabc@localhost:5432/jakartabc

# ----- Redis (shared / external) -----
REDIS_URL=redis://host.docker.internal:6379
REDIS_KEY_PREFIX=jakartabc:local

# ----- MinIO (shared / external, public-read bucket) -----
MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=jakartabc
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
MINIO_PUBLIC_URL=http://localhost:9000/jakartabc
MINIO_FORCE_PATH_STYLE=true

# ----- Payload -----
PAYLOAD_SECRET=replace-with-32-plus-char-random-string

# ----- Next.js -----
# Local docker stack: use http://localhost:3100
# Production: https://jakartabc.com
NEXT_PUBLIC_SITE_URL=http://localhost:3100
DEFAULT_LOCALE=en

# Reverse proxy + TLS are handled by a native nginx on the server host,
# not by this compose stack — no domain/ACME vars needed here.
TRUSTED_PROXY_SECRET=replace-with-32-plus-char-random-string

# ----- Email (Phase 3) -----
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="Jakarta Business Center <hello@jakartabc.com>"
SALES_EMAIL=sales@jakartabc.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ----- Anti-spam (Phase 3) -----
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ----- Revalidation (Phase 2) -----
REVALIDATE_SECRET=replace-with-shared-secret

# ----- Portal (apps/portal) -----
# Local: leave blank or set to localhost (cookie scoped to host)
# Production: app.jakartabc.com
PORTAL_COOKIE_DOMAIN=
NEXT_PUBLIC_PORTAL_URL=http://localhost:3101
